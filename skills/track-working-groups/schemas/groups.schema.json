{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Track Working Groups - Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "groups"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    }
  },
  "$defs": {
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "name",
        "organization",
        "tracking_status",
        "membership_status",
        "priority",
        "topics",
        "sources",
        "links",
        "meetings"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^WG-[0-9]{4,}$"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "organization": {
          "type": "string",
          "minLength": 1
        },
        "tracking_status": {
          "enum": [
            "active",
            "paused",
            "archived"
          ]
        },
        "membership_status": {
          "enum": [
            "unconfirmed",
            "observer",
            "member",
            "contributor",
            "left"
          ]
        },
        "priority": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "url"
            ],
            "properties": {
              "kind": {
                "const": "github"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "url"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        },
        "meetings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "starts_at",
              "url"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^MTG-[0-9A-F]{16}$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "starts_at": {
                "type": "string",
                "format": "date-time"
              },
              "url": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uri"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
