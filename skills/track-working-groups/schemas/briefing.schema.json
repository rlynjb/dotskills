{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Track Working Groups - Briefing v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "summary",
    "groups"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groups_checked",
        "new_or_changed",
        "sources_ok",
        "sources_unavailable"
      ],
      "properties": {
        "groups_checked": {
          "type": "integer",
          "minimum": 0
        },
        "new_or_changed": {
          "type": "integer",
          "minimum": 0
        },
        "sources_ok": {
          "type": "integer",
          "minimum": 0
        },
        "sources_unavailable": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "priority",
          "topics",
          "sources",
          "updates",
          "meetings"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^WG-[0-9]{4,}$"
          },
          "name": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url",
                "status",
                "checked_at",
                "new_count",
                "error"
              ],
              "properties": {
                "url": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "ok",
                    "unavailable",
                    "unconfigured"
                  ]
                },
                "checked_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "new_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "error": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "updates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "url",
                "title",
                "updated_at",
                "state",
                "id"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "issue",
                    "pull_request",
                    "commit"
                  ]
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "title": {
                  "type": "string"
                },
                "updated_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "state": {
                  "type": "string"
                },
                "id": {
                  "type": "string",
                  "pattern": "^UPD-[A-F0-9]{16}$"
                }
              }
            }
          },
          "meetings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "title",
                "starts_at",
                "url"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^MTG-[0-9A-F]{16}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "starts_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "url": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uri"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
